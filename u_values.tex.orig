\prompt{In}{incolor}{3}{\boxspacing}
>>>>>>> 01ccaba (got better degree days info.)
\begin{Verbatim}[commandchars=\\\{\}]
\PY{k}{def}\PY{+w}{ }\PY{n+nf}{lambda\PYZus{}val}\PY{p}{(}\PY{n}{material}\PY{p}{)}\PY{p}{:}
\PY{+w}{    }\PY{l+s+sd}{\PYZdq{}\PYZdq{}\PYZdq{}Get thermal conductivity with units.\PYZdq{}\PYZdq{}\PYZdq{}}
    \PY{k}{return} \PY{n}{LAMBDA}\PY{p}{[}\PY{n}{material}\PY{p}{]} \PY{o}{*} \PY{n}{ureg}\PY{o}{.}\PY{n}{W} \PY{o}{/} \PY{p}{(}\PY{n}{ureg}\PY{o}{.}\PY{n}{m} \PY{o}{*} \PY{n}{ureg}\PY{o}{.}\PY{n}{kelvin}\PY{p}{)} 

\PY{k}{def}\PY{+w}{ }\PY{n+nf}{R\PYZus{}value}\PY{p}{(}\PY{n}{element}\PY{p}{,} \PY{n}{thickness}\PY{p}{)}\PY{p}{:}
\PY{+w}{    }\PY{l+s+sd}{\PYZdq{}\PYZdq{}\PYZdq{}Calculate R\PYZhy{}value (thermal resistance) for a wall element.\PYZdq{}\PYZdq{}\PYZdq{}}
    \PY{k}{return}  \PY{n}{thickness}\PY{o}{/} \PY{n}{lambda\PYZus{}val}\PY{p}{(}\PY{n}{element}\PY{p}{)}

\PY{k}{def}\PY{+w}{ }\PY{n+nf}{U\PYZus{}value}\PY{p}{(}\PY{n}{wall}\PY{p}{)}\PY{p}{:}
\PY{+w}{    }\PY{l+s+sd}{\PYZdq{}\PYZdq{}\PYZdq{}}
\PY{l+s+sd}{    The U value of the wall, in SI units.}
\PY{l+s+sd}{    \PYZdq{}\PYZdq{}\PYZdq{}}
    \PY{n}{units\PYZus{}of\PYZus{}U} \PY{o}{=} \PY{n}{ureg}\PY{o}{.}\PY{n}{watt} \PY{o}{/} \PY{n}{ureg}\PY{o}{.}\PY{n}{meter} \PY{o}{*}\PY{o}{*} \PY{l+m+mi}{2} \PY{o}{/} \PY{n}{ureg}\PY{o}{.}\PY{n}{K}
    \PY{n}{tot\PYZus{}R} \PY{o}{=} \PY{l+m+mf}{0.0} \PY{o}{/} \PY{n}{units\PYZus{}of\PYZus{}U}
    \PY{k}{for} \PY{n}{i} \PY{o+ow}{in} \PY{n}{wall}\PY{p}{:}
        \PY{n}{R} \PY{o}{=} \PY{n}{R\PYZus{}value}\PY{p}{(}\PY{n}{i}\PY{p}{,}\PY{n}{wall}\PY{p}{[}\PY{n}{i}\PY{p}{]} \PY{o}{*} \PY{n}{ureg}\PY{o}{.}\PY{n}{meters}\PY{p}{)}
        \PY{n}{tot\PYZus{}R} \PY{o}{+}\PY{o}{=} \PY{n}{R}
    \PY{k}{return} \PY{l+m+mf}{1.}\PY{o}{/}\PY{n}{tot\PYZus{}R}
    
\end{Verbatim}
\end{tcolorbox}

